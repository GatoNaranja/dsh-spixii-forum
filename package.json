{
  "name": "@local/dsh-spixii-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "带鲸鲸去 spixii.cn 逛论坛的 DSH 插件：自动拉起 BrowserSkill、核对身份、读完整栋楼、看图、回帖，逛完静默关窗。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "browser-skill",
    "bsk",
    "forum",
    "spixii"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
